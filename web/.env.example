# Copy to .env.local and fill in values. Never commit .env.local. Names only here.

# --- Reports (required for the Reported tier, contest and graph) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (32+ chars) used to HMAC identifiers and reporter fingerprints
REPORT_HASH_PEPPER=
# Not read by the code (the app only uses the service-role key on the server); kept because docs/SPEC.md lists it
SUPABASE_ANON_KEY=

# --- Verified tier ---
ETHERSCAN_API_KEY=
# Optional: requests per second (default 2; the free plan rejects bursts at 3)
ETHERSCAN_RPS=
# Optional: "paid" if your Etherscan plan covers BNB Chain and Base
ETHERSCAN_PLAN=
# Optional: higher TronGrid rate limits (works without it)
TRONGRID_API_KEY=

# --- Link graph (optional; Postgres fallback otherwise) ---
# TigerGraph Savanna workspace host (https://<id>.i.tgcloud.io), graph name (default ScamLens), database secret
TG_HOST=
TG_GRAPH=
TG_SECRET=
# Optional: hub filter - nodes with more distinct counterparties than this never link people (default 25)
GRAPH_HUB_MAX=

# --- AI pass (optional; regex rules only without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: base URL for an OpenAI-compatible provider (blank = OpenAI)
OPENAI_BASE_URL=

# --- Limits ---
# Optional: max report submissions per reporter per day (default 5)
REPORTS_MAX_PER_DAY=
