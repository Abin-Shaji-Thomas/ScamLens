# Copy to .env.local and fill in values. Never commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# TigerGraph Savanna: workspace host (https://<id>.i.tgcloud.io), graph name (default ScamLens), database secret
TG_HOST=
TG_GRAPH=
TG_SECRET=
# Required for reports: random secret (32+ chars) used to HMAC identifiers and reporter fingerprints
REPORT_HASH_PEPPER=
# Optional: max report submissions per reporter per day (default 5)
REPORTS_MAX_PER_DAY=
# Optional: hub filter - nodes with more distinct counterparties than this never link people (default 25)
GRAPH_HUB_MAX=
# Optional: base URL for an OpenAI-compatible provider (blank = OpenAI)
OPENAI_BASE_URL=
# Optional: Etherscan requests per second (default 2; the free plan rejects bursts at 3)
ETHERSCAN_RPS=
# Optional: set to "paid" if your Etherscan plan covers BNB Chain and Base
ETHERSCAN_PLAN=
