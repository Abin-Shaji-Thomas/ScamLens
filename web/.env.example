# Copy to .env.local and fill in values. Never commit .env.local. Names only here.

# --- Reports (required for the Reported tier, contest and graph) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (32+ chars) used to HMAC identifiers and reporter fingerprints
REPORT_HASH_PEPPER=
# Not read by the code (the app only uses the service-role key on the server); kept because docs/SPEC.md lists it
SUPABASE_ANON_KEY=

# --- Verified tier ---
ETHERSCAN_API_KEY=
# Optional: requests per second (default 2; the free plan rejects bursts at 3)
ETHERSCAN_RPS=
# Optional: "paid" if your Etherscan plan covers BNB Chain and Base
ETHERSCAN_PLAN=
# Optional: higher TronGrid rate limits (works without it)
TRONGRID_API_KEY=

# --- Link graph (optional; Postgres fallback otherwise) ---
# TigerGraph Savanna workspace host (https://<id>.i.tgcloud.io), graph name (default ScamLens), database secret
TG_HOST=
TG_GRAPH=
TG_SECRET=
# Optional: hub filter - nodes with more distinct counterparties than this never link people (default 25)
GRAPH_HUB_MAX=

# --- AI pass (optional; regex rules only without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: model for reading screenshots (must accept images); falls back to OPENAI_MODEL
OPENAI_VISION_MODEL=
# Optional: base URL for an OpenAI-compatible provider (blank = OpenAI)
OPENAI_BASE_URL=

# --- Limits ---
# Optional: max report submissions per reporter per day (default 5)
REPORTS_MAX_PER_DAY=
# Optional: abuse guard (daily, per network fingerprint; counters in Supabase usage_counters, memory fallback)
USAGE_CHECK_PER_DAY=
USAGE_TRANSCRIBE_PER_DAY=
USAGE_GRAPH_PER_DAY=
USAGE_CONTEST_PER_DAY=
# Optional: server-side receipt checks per network per day (default 60)
USAGE_VERIFY_PER_DAY=
# Optional: contributed cases (default 5) and "Was this right?" answers (default 30) per network per day
USAGE_CASE_PER_DAY=
USAGE_FEEDBACK_PER_DAY=
# Optional: global daily cap on LLM-using calls (check AI pass + screenshot reading), default 1500
USAGE_GLOBAL_LLM_PER_DAY=

# --- Signed check receipts (optional; off without it) ---
# Ed25519 private key, base64 PKCS8 DER on one line. Generate your own (docs/DEPLOY.md); never commit or share it.
RECEIPT_SIGNING_KEY=

# --- Share preview (optional, not a secret) ---
# Public site URL, e.g. https://scam-lens-two.vercel.app; makes share-image links absolute
NEXT_PUBLIC_SITE_URL=
