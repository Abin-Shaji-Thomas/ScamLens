# ScamLens link graph for TigerGraph 4.x / Savanna.
# Applied by web/scripts/tg-setup.ts through POST /gsql/v1/statements.
#
# Vertex primary ids are the same peppered HMAC-SHA256 hashes the app stores in Postgres,
# and `display` is the masked form (e.g. "zz***d@okdemo"). No raw identifiers or chats are loaded.
# Every identifier vertex has the same attributes so queries can treat them uniformly:
#   kind            evm | tron | btc | upi | telegram | phone | email | domain
#   flagged_source  non-empty when the address is on a flag list (OFAC, ScamSniffer, synthetic demo flag)
#   is_exchange     exchange/hot-wallet addresses never link people (hub filter)
# A Report vertex is one community report; MENTIONS joins it to each identifier it named, so two
# identifiers are "co-reported" when they share a Report. PAID is an on-chain transfer between wallets.

CREATE VERTEX Wallet (PRIMARY_ID hash STRING, kind STRING, display STRING, flagged_source STRING, is_exchange BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX UPI (PRIMARY_ID hash STRING, kind STRING, display STRING, flagged_source STRING, is_exchange BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX TelegramHandle (PRIMARY_ID hash STRING, kind STRING, display STRING, flagged_source STRING, is_exchange BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX PhoneNumber (PRIMARY_ID hash STRING, kind STRING, display STRING, flagged_source STRING, is_exchange BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Domain (PRIMARY_ID hash STRING, kind STRING, display STRING, flagged_source STRING, is_exchange BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Report (PRIMARY_ID submission_id STRING, evidence STRING, synthetic BOOL, reporter_key STRING) WITH primary_id_as_attribute="true"

CREATE UNDIRECTED EDGE MENTIONS (FROM Report, TO Wallet | FROM Report, TO UPI | FROM Report, TO TelegramHandle | FROM Report, TO PhoneNumber | FROM Report, TO Domain)
CREATE DIRECTED EDGE PAID (FROM Wallet, TO Wallet, evidence STRING)

CREATE GRAPH ScamLens (Wallet, UPI, TelegramHandle, PhoneNumber, Domain, Report, MENTIONS, PAID)
